# Copie este archivo como .deploy.env y complete los valores una sola vez.
# .deploy.env está ignorado por Git y nunca se publica.

PRODUCTION_SSH_TARGET=noxpana@servidor.example.com
PRODUCTION_SSH_PORT=22
PRODUCTION_SSH_IDENTITY_FILE=/ruta/privada/llave_ed25519
PRODUCTION_ROOT=/home/noxpana/public_html
PRODUCTION_BACKUP_ROOT=/home/noxpana/deploy-backups/nox
PRODUCTION_HEALTH_URL=https://admin.noxpanama.com/api/health/

# Opcional pero recomendado. El archivo debe existir solamente en el servidor,
# tener chmod 600 y contener las credenciales MySQL en la sección [client].
# Al configurarlo, cada despliegue aplica el schema idempotente.
PRODUCTION_MYSQL_DEFAULTS_FILE=/home/noxpana/.my.cnf
